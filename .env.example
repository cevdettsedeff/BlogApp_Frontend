# API Base URL
NEXT_PUBLIC_API_URL=https://localhost:7264
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_REMOTE_LOGS=true
NEXT_PUBLIC_LOG_INGEST_URL=https://localhost:7264/api/logs/client
NEXT_PUBLIC_REMOTE_LOG_LEVEL=warn
NEXT_PUBLIC_REMOTE_LOG_BATCH_SIZE=20
NEXT_PUBLIC_REMOTE_LOG_FLUSH_MS=5000
NEXT_PUBLIC_REMOTE_LOG_MAX_QUEUE=200
# Production preset:
# NEXT_PUBLIC_LOG_LEVEL=warn
# NEXT_PUBLIC_REMOTE_LOG_LEVEL=warn

# Post view delay (ms)
NEXT_PUBLIC_POST_VIEW_DELAY_MS=10000

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
